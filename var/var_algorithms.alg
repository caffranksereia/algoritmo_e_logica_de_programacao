Algoritmo "variable_type_basic"

Var
    idade: inteiro
    altura: real
    nome: caractere
    estudando: logico
Inicio
    idade <- 32
    altura <- 1.75
    nome <- "Fabio"
    estudando <- verdadeiro 

    escreval("Nome: ", nome)
    escreval("Idade: ", idade)
    escreval("Altura: ", altura)
    escreval("Está estudando: ", estudando)

Fimalgoritmo