Algoritmo "enquanto exercicios"
Var
    x, y: inteiro

Inicio

    escreva("digite dois numeros:")
    leia(x)
    leia(y)
    enquanto x <> y faca
       se x < y entao
           escreval("Crescente")
        senao
            escreval("Decrescente")
        fimse
        escreva("digite dois numeros:")
        leia(x)
        leia(y)

    fimenquanto

fimalgoritmo